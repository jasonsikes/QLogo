foreach [a b c] [show (list # ? ?rest)]
(foreach [1 2 3] [a b c] [print (se # ?1 ?2)])
(foreach "ab "12 [print (word ?1 ?2)])
foreach "hi [print (se # ?)]
foreach [a b] [repeat 2 [print (list ? repcount #)]]
