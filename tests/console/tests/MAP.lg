show map [? * ?] [1 2 3]
show map [? * 10] map [? + 1] [1 2 3]
show map [[n] map [? * :n] [1 2 3]] [1 2 3]
show map [[row] map [(list # ?)] :row] [[a b] [c d e]]
show map [[row] map [[cell] map [? * :cell] :row] :row] [[1 2]]
show (map [(word ?1 ?2 ?3)] [a b] [1 2] [x y])
show map [word ? "x] "ab
show map [? * 2] iseq 3 1
show map [? * 2] []
show map [[x] map [? + :x] iseq 1 3] iseq 0 1
