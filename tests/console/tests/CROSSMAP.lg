show (crossmap [word ?1 ?2] [a b c] [1 2])
show crossmap [word ?1 ?2] [[a b] [1 2]]
show (crossmap [word :1 :2] [a b] [1 2])
show (crossmap [[p q] (crossmap [(word :p :q ?2)] (list :p) [x y])] [a b] [1 2])
show (crossmap [(list :1 (crossmap [word :1 :2] (list :1) [x y]))] [a b] [1])
show map [[row] (crossmap [word ?1 ?2] first :row last :row)] [[[a b] [1 2]] [[c] [3 4]]]
show (crossmap [(word ?1 ?2 ?3)] [a b] [1] [x y])
