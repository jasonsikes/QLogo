  <name>Psychi</name>
  <summary>UCBLogo-compatible interpreter using Qt</summary>
  <description>
    <p>
      A modern graphical environment for the QLogo interpreter, with a command line,
      a text editor, and a turtle graphics window. QLogo follows the UCBLogo
      language developed by Brian Harvey at the University of California,
      Berkeley.
    </p>
  </description>
  <launchable type="desktop-id">org.qlogo.Psychi.desktop</launchable>
  <provides>
    <binary>Psychi</binary>
    <binary>qlogo</binary>
  </provides>

